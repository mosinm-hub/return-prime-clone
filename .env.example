# From your app's client credentials in the Shopify Partner Dashboard
# (Partner Dashboard → your app → Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Permission scopes this app requests — matches shopify.app.toml
SCOPES=read_orders,write_orders,read_products,write_draft_orders,read_customers,read_fulfillments,write_inventory

# Your Vercel production URL, e.g. https://returns-app.vercel.app
# (or your custom domain once attached)
SHOPIFY_APP_URL=

# ── Database (Neon or Supabase Postgres) ────────────────────────────────
# DATABASE_URL: pooled/pgbouncer connection string — used at runtime by
#   the app (serverless functions open lots of short-lived connections,
#   so this MUST go through the pooler, not a direct connection).
# DIRECT_URL: direct (non-pooled) connection string — used only by
#   `prisma migrate deploy` during build, since migrations need a session
#   that pgbouncer's transaction mode doesn't support.
#
# Neon: Project → Connection Details →
#   DATABASE_URL = the "pooled connection" string (has "-pooler" in the host)
#   DIRECT_URL   = the "direct connection" string
#
# Supabase: Project → Settings → Database →
#   DATABASE_URL = "Connection pooling" string, port 6543, add ?pgbouncer=true
#   DIRECT_URL   = "Connection string" (direct), port 5432
DATABASE_URL=
DIRECT_URL=
